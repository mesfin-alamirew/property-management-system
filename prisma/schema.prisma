// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String  @unique
  isActive Boolean @default(true)

  regions           Region[]
  organizationUnits OrganizationUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrganizationUnitType {
  HEADQUARTERS
  REGIONAL_OFFICE
  COUNTRY_OFFICE
  LIAISON_OFFICE
  PROJECT_OFFICE
  FIELD_OFFICE
}

model OrganizationUnit {
  // Identity
  id String @id @default(cuid())

  // Business Fields
  code        String               @unique
  name        String
  description String?
  type        OrganizationUnitType

  // Relationships
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  parentId String?
  parent   OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationHierarchy")

  properties Property[]
  employees  Employee[]

  assetLocations AssetLocation[]

  physicalVerifications PhysicalVerification[]

  // Status
  isActive Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([countryId])
  @@index([parentId])
}

model PropertyType {
  // Identity
  id String @id @default(cuid())

  // Business Fields
  code        String  @unique
  name        String  @unique
  description String?

  // Relationships
  properties Property[]

  // Status
  isActive Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([isActive])
}

model PropertyStatus {
  id String @id @default(cuid())

  code        String  @unique
  name        String  @unique
  description String?

  properties Property[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model PropertyTenure {
  id String @id @default(cuid())

  code String @unique

  name String @unique

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  properties Property[]

  @@index([isActive])
}

model Property {
  // Identity
  id String @id @default(cuid())

  // Business Fields
  propertyCode String  @unique
  name         String
  displayName  String?
  description  String?

  address       String?
  city          String?
  stateProvince String?
  postalCode    String?

  latitude  Decimal?
  longitude Decimal?

  constructionDate DateTime?
  grossAreaSqm     Decimal?

  // Relationships
  organizationUnitId String
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id])

  propertyTypeId String
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id])

  propertyCategoryId String?
  propertyCategory   PropertyCategory? @relation(fields: [propertyCategoryId], references: [id])

  propertyTenureId String?
  propertyTenure   PropertyTenure? @relation(fields: [propertyTenureId], references: [id])

  propertyStatusId String?
  propertyStatus   PropertyStatus? @relation(fields: [propertyStatusId], references: [id])

  // Buildings
  buildings Building[]

  ownerships Ownership[]

  isActive Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([organizationUnitId])
  @@index([propertyTypeId])
  @@index([propertyCategoryId])
  @@index([propertyTenureId])
  @@index([propertyStatusId])
  @@index([isActive])
}

model Region {
  id String @id @default(cuid())

  code String
  name String

  countryId String

  country Country @relation(fields: [countryId], references: [id])

  zones    Zone[]
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@index([countryId])
}

model Zone {
  id String @id @default(cuid())

  code String
  name String

  regionId String

  region Region @relation(fields: [regionId], references: [id])

  woredas  Woreda[]
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regionId, code])
  @@unique([regionId, name])
  @@index([regionId])
}

model Woreda {
  id String @id @default(cuid())

  zoneId String

  zone Zone @relation(fields: [zoneId], references: [id])

  code String
  name String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, code])
  @@unique([zoneId, name])
  @@index([zoneId])
}

model PropertyCategory {
  id String @id @default(cuid())

  code        String  @unique
  name        String  @unique
  description String?

  parentId String?
  parent   PropertyCategory?  @relation("PropertyCategoryHierarchy", fields: [parentId], references: [id])
  children PropertyCategory[] @relation("PropertyCategoryHierarchy")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@index([parentId])
  @@index([isActive])
}

model BuildingType {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings Building[]

  @@index([isActive])
}

model BuildingCondition {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings Building[]

  @@index([isActive])
}

model Building {
  id String @id @default(cuid())

  // Identity
  buildingCode String
  name         String
  description  String?

  // Relationships
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  buildingTypeId String
  buildingType   BuildingType @relation(fields: [buildingTypeId], references: [id])

  buildingConditionId String?
  buildingCondition   BuildingCondition? @relation(fields: [buildingConditionId], references: [id])

  spaces BuildingSpace[]

  // Physical characteristics
  numberOfFloors    Int?
  numberOfBasements Int?

  // Construction
  yearBuilt     Int?
  yearRenovated Int?

  // Areas
  floorAreaSqm  Decimal?
  usableAreaSqm Decimal?

  // Capacity
  numberOfRooms   Int?
  numberOfUnits   Int?
  parkingCapacity Int?

  // Lifecycle
  isActive Boolean @default(true)

  // Additional information
  accessibilityFeatures String?
  notes                 String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, buildingCode])
  @@index([propertyId])
  @@index([buildingTypeId])
  @@index([buildingConditionId])
  @@index([isActive])
}

model BuildingSpace {
  id String @id @default(cuid())

  // Identity
  code String
  name String

  // Relationships
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  spaceTypeId String
  spaceType   BuildingSpaceType @relation(fields: [spaceTypeId], references: [id])

  // Physical characteristics
  floorNumber Int?
  areaSqm     Decimal?
  capacity    Int?

  // Lifecycle
  isActive Boolean @default(true)

  // Additional information
  notes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, code])
  @@index([buildingId])
  @@index([spaceTypeId])
  @@index([isActive])
}

model BuildingSpaceType {
  id String @id @default(cuid())

  // Business fields
  code        String
  name        String
  description String?

  // Lifecycle
  isActive Boolean @default(true)

  // Relationships
  spaces BuildingSpace[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@unique([code])
  @@unique([name])
  @@index([isActive])
}

model OwnershipType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerships Ownership[]
}

model Ownership {
  id String @id @default(cuid())

  propertyId      String
  ownershipTypeId String

  startDate DateTime
  endDate   DateTime?

  acquisitionDate     DateTime?
  acquisitionPrice    Decimal?  @db.Decimal(18, 2)
  acquisitionCurrency String?

  deedNumber            String?
  legalReference        String?
  registrationAuthority String?

  notes String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property      Property      @relation(fields: [propertyId], references: [id])
  ownershipType OwnershipType @relation(fields: [ownershipTypeId], references: [id])

  @@index([propertyId])
  @@index([ownershipTypeId])
  @@index([propertyId, isActive])
}

///ASSET///
model AssetCategory {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  parentId String?
  parent   AssetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children AssetCategory[] @relation("CategoryHierarchy")

  assetTypes AssetType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
}

model AssetType {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  categoryId String
  category   AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model AssetStatus {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AssetCondition {
  id String @id @default(cuid())

  code        String  @unique
  name        String
  description String?

  isActive Boolean @default(true)

  assets Asset[]

  physicalVerificationItemsExpected PhysicalVerificationItem[] @relation("PhysicalVerificationExpectedCondition")

  unregisteredAssetObservations UnregisteredAssetObservation[] @relation("UnregisteredAssetObservedCondition")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Asset {
  id String @id @default(cuid())

  assetCode   String  @unique
  assetTag    String? @unique
  name        String
  description String?

  manufacturer String?
  model        String?
  serialNumber String?

  assetTypeId String
  statusId    String
  conditionId String

  locationId String?

  assetType AssetType      @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  status    AssetStatus    @relation(fields: [statusId], references: [id], onDelete: Restrict)
  condition AssetCondition @relation(fields: [conditionId], references: [id], onDelete: Restrict)

  location AssetLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  acquisitionItem               AcquisitionItem?
  assetMovements                AssetMovement[]
  assetAssignments              AssetAssignment[]
  physicalVerificationItems     PhysicalVerificationItem[]
  unregisteredAssetObservations UnregisteredAssetObservation[]
  maintenances                  Maintenance[]
  incidents                     Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetTypeId])
  @@index([statusId])
  @@index([conditionId])
  @@index([serialNumber])
  @@index([locationId])
}

model AssetLocation {
  id String @id @default(cuid())

  code        String  @unique
  name        String  @unique
  description String?

  organizationUnitId String

  organizationUnit OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  assets Asset[]

  movementsFrom AssetMovement[] @relation("MovementFromLocation")
  movementsTo   AssetMovement[] @relation("MovementToLocation")

  physicalVerifications PhysicalVerification[]

  physicalVerificationItemsExpectedLocation PhysicalVerificationItem[] @relation("PhysicalVerificationExpectedLocation")

  unregisteredAssetObservations UnregisteredAssetObservation[] @relation("UnregisteredAssetObservedLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationUnitId])
  @@index([isActive])
}

model AssetMovement {
  id String @id @default(cuid())

  assetId String

  fromLocationId String?
  toLocationId   String

  movedAt DateTime @default(now())

  movedByUserId String

  reason String?
  notes  String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  fromLocation AssetLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)

  toLocation AssetLocation @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  movedByUser User @relation(fields: [movedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([movedByUserId])
  @@index([movedAt])
}

model AssetCodeSequence {
  id         String @id @default(cuid())
  year       Int    @unique
  lastNumber Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcquisitionNumberSequence {
  id         String @id @default(cuid())
  year       Int    @unique
  lastNumber Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PhysicalVerificationNumberSequence {
  id String @id @default(cuid())

  year Int @unique

  lastNumber Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model AcquisitionMethod {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  acquisitions Acquisition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Acquisition {
  id                String   @id @default(cuid())
  acquisitionNumber String   @unique
  acquisitionDate   DateTime

  acquisitionMethodId String
  acquisitionMethod   AcquisitionMethod @relation(fields: [acquisitionMethodId], references: [id], onDelete: Restrict)

  supplierName    String?
  referenceNumber String?
  description     String?
  fundingSource   String?

  totalAmount Decimal?
  currency    String?
  notes       String?

  items AcquisitionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([acquisitionMethodId])
  @@index([acquisitionDate])
}

model AcquisitionItem {
  id String @id @default(cuid())

  acquisitionId String
  assetId       String @unique

  acquisition Acquisition @relation(fields: [acquisitionId], references: [id], onDelete: Cascade)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  unitCost  Decimal?
  totalCost Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([acquisitionId])
}

model Employee {
  id String @id @default(cuid())

  employeeNumber String @unique

  firstName String

  middleName String?

  lastName String

  organizationUnitId String

  organizationUnit OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  assetAssignments AssetAssignment[]

  user User?

  physicalVerificationItemsExpected PhysicalVerificationItem[] @relation("PhysicalVerificationExpectedEmployee")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([organizationUnitId])
  @@index([lastName])
  @@index([isActive])
}

model AssetAssignment {
  id String @id @default(cuid())

  assetId    String
  employeeId String

  assignedAt       DateTime @default(now())
  assignedByUserId String

  returnedAt       DateTime?
  returnedByUserId String?

  notes String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  assignedByUser User @relation("AssetAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  returnedByUser User? @relation("AssetAssignmentReturnedBy", fields: [returnedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([employeeId])
  @@index([assignedAt])
  @@index([returnedAt])
  @@index([assignedByUserId])
  @@index([returnedByUserId])
}

model User {
  id String @id @default(cuid())

  employeeId String? @unique

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  username String @unique

  displayName String

  isActive Boolean @default(true)

  identities UserIdentity[]

  sessions       Session[]
  assetMovements AssetMovement[]

  assetAssignmentsMade  AssetAssignment[] @relation("AssetAssignmentAssignedBy")
  assetReturnsProcessed AssetAssignment[] @relation("AssetAssignmentReturnedBy")

  userRolesAssigned UserRole[] @relation("UserRoleAssignments")

  rolesAssigned UserRole[] @relation("UserRoleAssignedBy")

  rolesRemoved UserRole[] @relation("UserRoleRemovedBy")

  physicalVerificationsCreated PhysicalVerification[] @relation("PhysicalVerificationCreatedBy")

  physicalVerificationItemsVerified PhysicalVerificationItem[] @relation("PhysicalVerificationVerifiedBy")

  unregisteredAssetObservations UnregisteredAssetObservation[] @relation("UnregisteredAssetObservedBy")

  maintenanceRequests Maintenance[] @relation("MaintenanceRequestedBy")

  maintenanceAssignments Maintenance[] @relation("MaintenanceAssignedTo")

  maintenanceApprovals Maintenance[] @relation("MaintenanceApprovedBy")

  incidentsReported Incident[] @relation("IncidentReportedBy")
  incidentsAssigned Incident[] @relation("IncidentAssignedTo")

  incidentResolutions IncidentResolution[] @relation("IncidentResolvedBy")

  auditLogs AuditLog[] @relation("AuditLogPerformedBy")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Role {
  id String @id @default(cuid())

  code String @unique

  name String

  description String?

  isActive Boolean @default(true)

  userRoles UserRole[]

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model UserRole {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Restrict)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now())

  assignedByUserId String
  assignedByUser   User   @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  removedAt       DateTime?
  removedByUserId String?
  removedByUser   User?     @relation("UserRoleRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@index([removedByUserId])
  @@index([removedAt])
}

model Permission {
  id String @id @default(cuid())

  code String @unique

  resource String

  action String

  description String?

  isActive Boolean @default(true)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
  @@index([isActive])
}

model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

enum AuthProvider {
  LOCAL
  AZURE_AD
}

model UserIdentity {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  provider AuthProvider

  externalId String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  expiresAt DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PhysicalVerification {
  id String @id @default(cuid())

  // Business Identity

  referenceNumber String @unique

  title String

  // Scope

  scope PhysicalVerificationScope

  organizationUnitId String?

  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  locationId String?

  location AssetLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // Lifecycle

  status PhysicalVerificationStatus @default(DRAFT)

  scheduledAt DateTime?

  startedAt DateTime?

  completedAt DateTime?

  notes String?

  // Accountability

  createdByUserId String

  createdByUser User @relation("PhysicalVerificationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // Verification Records

  items PhysicalVerificationItem[]

  unregisteredObservations UnregisteredAssetObservation[]

  // Audit

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Indexes

  @@index([status])
  @@index([scope])
  @@index([organizationUnitId])
  @@index([locationId])
  @@index([createdByUserId])
}

model PhysicalVerificationItem {
  id String @id @default(cuid())

  // Verification / Asset Identity

  verificationId String

  verification PhysicalVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  assetId String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // Expected Asset Snapshot

  expectedAssetCode String

  expectedAssetTag String?

  expectedSerialNumber String?

  expectedAssetName String

  // Expected Custodian Snapshot

  expectedEmployeeId String?

  expectedEmployee Employee? @relation("PhysicalVerificationExpectedEmployee", fields: [expectedEmployeeId], references: [id], onDelete: Restrict)

  expectedEmployeeNumber String?

  expectedEmployeeName String?

  // Expected Location Snapshot

  expectedLocationId String?

  expectedLocation AssetLocation? @relation("PhysicalVerificationExpectedLocation", fields: [expectedLocationId], references: [id], onDelete: Restrict)

  expectedLocationCode String?

  expectedLocationName String?

  // Expected Condition Snapshot

  expectedConditionId String?

  expectedCondition AssetCondition? @relation("PhysicalVerificationExpectedCondition", fields: [expectedConditionId], references: [id], onDelete: Restrict)

  expectedConditionCode String?

  expectedConditionName String?

  // Observed Asset

  observedAssetTag String?

  observedSerialNumber String?

  // Observed Custodian Snapshot

  observedEmployeeNumber String?

  observedEmployeeName String?

  // Observed Location Snapshot

  observedLocationCode String?

  observedLocationName String?

  // Observed Condition Snapshot

  observedConditionCode String?

  observedConditionName String?

  // Result

  result PhysicalVerificationResult @default(PENDING)

  notes String?

  // Verification Accountability

  verifiedByUserId String?

  verifiedByUser User? @relation("PhysicalVerificationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict)

  verifiedAt DateTime?

  // Audit

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Constraints / Indexes

  @@unique([verificationId, assetId])
  @@index([assetId])
  @@index([verificationId])
  @@index([result])
  @@index([expectedEmployeeId])
  @@index([expectedLocationId])
  @@index([expectedConditionId])
  @@index([verifiedByUserId])
}

model UnregisteredAssetObservation {
  id String @id @default(cuid())

  // Verification

  verificationId String

  verification PhysicalVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  // Physical Identification

  observedAssetTag String?

  observedSerialNumber String?

  observedName String

  // Location Snapshot

  observedLocationId String?

  observedLocation AssetLocation? @relation("UnregisteredAssetObservedLocation", fields: [observedLocationId], references: [id], onDelete: Restrict)

  observedLocationCode String?

  observedLocationName String?

  // Condition Snapshot

  observedConditionId String?

  observedCondition AssetCondition? @relation("UnregisteredAssetObservedCondition", fields: [observedConditionId], references: [id], onDelete: Restrict)

  observedConditionCode String?

  observedConditionName String?

  // Observation

  notes String?

  observedByUserId String

  observedByUser User @relation("UnregisteredAssetObservedBy", fields: [observedByUserId], references: [id], onDelete: Restrict)

  observedAt DateTime

  // Later Registration

  registeredAssetId String?

  registeredAsset Asset? @relation(fields: [registeredAssetId], references: [id], onDelete: Restrict)

  // Audit

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Indexes

  @@index([verificationId])
  @@index([observedLocationId])
  @@index([observedConditionId])
  @@index([observedByUserId])
  @@index([registeredAssetId])
}

enum PhysicalVerificationScope {
  ORGANIZATION
  ORGANIZATION_UNIT
  LOCATION
  ORGANIZATION_UNIT_LOCATION
  SELECTED_ASSETS
}

enum PhysicalVerificationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PhysicalVerificationResult {
  PENDING
  VERIFIED
  NOT_FOUND
  LOCATION_MISMATCH
  CUSTODIAN_MISMATCH
  CONDITION_MISMATCH
  IDENTIFICATION_MISMATCH
  MULTIPLE_DISCREPANCIES
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
  PREDICTIVE
  INSPECTION
}

enum MaintenanceStatus {
  DRAFT
  REQUESTED
  ASSIGNED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceNumberSequence {
  id String @id @default(cuid())

  year Int @unique

  lastNumber Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Maintenance {
  id              String @id @default(cuid())
  referenceNumber String @unique

  assetId String
  type    MaintenanceType
  status  MaintenanceStatus @default(DRAFT)

  title       String
  description String?

  requestedAt DateTime?
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  requestedByUserId String
  assignedToUserId  String?
  approvedByUserId  String?
  approvedAt        DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id])

  requestedByUser User  @relation("MaintenanceRequestedBy", fields: [requestedByUserId], references: [id])
  assignedToUser  User? @relation("MaintenanceAssignedTo", fields: [assignedToUserId], references: [id])
  approvedByUser  User? @relation("MaintenanceApprovedBy", fields: [approvedByUserId], references: [id])

  services MaintenanceService[]

  @@index([assetId])
  @@index([status])
  @@index([type])
  @@index([requestedByUserId])
  @@index([assignedToUserId])
  @@index([approvedByUserId])
}

model MaintenanceService {
  id String @id @default(cuid())

  maintenanceId String

  serviceDate DateTime @default(now())

  description String

  serviceProvider String?

  quantity  Decimal? @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)
  totalCost Decimal? @db.Decimal(12, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Restrict)

  @@index([maintenanceId])
  @@index([serviceDate])
}

model AuditLog {
  id String @id @default(cuid())

  userId String

  action String

  entityType String

  entityId String

  description String

  oldValue Json?

  newValue Json?

  createdAt DateTime @default(now())

  user User @relation("AuditLogPerformedBy", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum IncidentType {
  DAMAGE
  LOSS
  THEFT
  ACCIDENT
  MALFUNCTION
  SECURITY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DRAFT
  REPORTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

model IncidentNumberSequence {
  id String @id @default(cuid())

  year Int @unique

  lastNumber Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Incident {
  id String @id @default(cuid())

  referenceNumber String @unique

  assetId String

  type IncidentType

  severity IncidentSeverity

  status IncidentStatus @default(DRAFT)

  title String

  description String?

  incidentDate DateTime

  reportedAt DateTime?
  assignedAt DateTime?
  startedAt  DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  reportedByUserId String
  assignedToUserId String?

  notes String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  reportedByUser User @relation("IncidentReportedBy", fields: [reportedByUserId], references: [id])

  assignedToUser User? @relation("IncidentAssignedTo", fields: [assignedToUserId], references: [id])

  resolution IncidentResolution?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([reportedByUserId])
  @@index([assignedToUserId])
  @@index([incidentDate])
}

model IncidentResolution {
  id String @id @default(cuid())

  incidentId String @unique

  rootCause String

  resolution String

  correctiveAction String?

  resolvedByUserId String

  notes String?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  resolvedByUser User @relation("IncidentResolvedBy", fields: [resolvedByUserId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([resolvedByUserId])
}
