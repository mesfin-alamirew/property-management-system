// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id                String               @id @default(cuid())
  code              String               @unique
  name              String               @unique
  isActive          Boolean              @default(true)

  organizationUnits OrganizationUnit[]

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

enum OrganizationUnitType {
  HEADQUARTERS
  REGIONAL_OFFICE
  COUNTRY_OFFICE
  LIAISON_OFFICE
  PROJECT_OFFICE
  FIELD_OFFICE
}


model OrganizationUnit {
  // Identity
  id          String               @id @default(cuid())

  // Business Fields
  code        String               @unique
  name        String
  description String?

  type        OrganizationUnitType

  // Relationships
  countryId   String?
  country     Country?             @relation(fields: [countryId], references: [id])

  parentId    String?
  parent      OrganizationUnit?    @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children    OrganizationUnit[]   @relation("OrganizationHierarchy")

  properties  Property[]

  // Status
  isActive    Boolean              @default(true)

  // Audit
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Indexes
  @@index([countryId])
  @@index([parentId])
}

model PropertyType {
  // Identity
  id          String      @id @default(cuid())

  // Business Fields
  code        String      @unique
  name        String      @unique
  description String?

  // Relationships
  properties  Property[]

  // Status
  isActive    Boolean     @default(true)

  // Audit
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Indexes
  @@index([isActive])
}

enum OwnershipType {
  OWNED
  LEASED
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  DISPOSED
}

model Property {
  // Identity
  id                 String            @id @default(cuid())

  // Business Fields
  propertyCode       String            @unique
  name               String
  displayName        String?
  description        String?

  address            String?
  city               String?
  stateProvince      String?
  postalCode         String?

  latitude           Decimal?
  longitude          Decimal?

  constructionDate   DateTime?
  grossAreaSqm       Decimal?

  // Relationships
  organizationUnitId String
  organizationUnit   OrganizationUnit  @relation(fields: [organizationUnitId], references: [id])

  propertyTypeId     String
  propertyType       PropertyType      @relation(fields: [propertyTypeId], references: [id])

  // Status
  ownership          OwnershipType
  status             PropertyStatus    @default(ACTIVE)
  isActive           Boolean           @default(true)

  // Audit
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Indexes
  @@index([organizationUnitId])
  @@index([propertyTypeId])
  @@index([propertyCode])
  @@index([name])
  @@index([status])
  @@index([isActive])
}