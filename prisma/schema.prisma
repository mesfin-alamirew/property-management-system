// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String  @unique
  isActive Boolean @default(true)

  regions           Region[]
  organizationUnits OrganizationUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrganizationUnitType {
  HEADQUARTERS
  REGIONAL_OFFICE
  COUNTRY_OFFICE
  LIAISON_OFFICE
  PROJECT_OFFICE
  FIELD_OFFICE
}

model OrganizationUnit {
  // Identity
  id String @id @default(cuid())

  // Business Fields
  code        String  @unique
  name        String
  description String?

  type OrganizationUnitType

  // Relationships
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  parentId String?
  parent   OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationHierarchy")

  properties Property[]

  // Status
  isActive Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([countryId])
  @@index([parentId])
}

model PropertyType {
  // Identity
  id String @id @default(cuid())

  // Business Fields
  code        String  @unique
  name        String  @unique
  description String?

  // Relationships
  properties Property[]

  // Status
  isActive Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([isActive])
}

model PropertyStatus {
  id String @id @default(cuid())

  code        String  @unique
  name        String  @unique
  description String?

  properties Property[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model PropertyTenure {
  id String @id @default(cuid())

  code String @unique

  name String @unique

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  properties Property[]

  @@index([isActive])
}

model Property {
  // Identity
  id String @id @default(cuid())

  // Business Fields
  propertyCode String  @unique
  name         String
  displayName  String?
  description  String?

  address       String?
  city          String?
  stateProvince String?
  postalCode    String?

  latitude  Decimal?
  longitude Decimal?

  constructionDate DateTime?
  grossAreaSqm     Decimal?

  // Relationships
  organizationUnitId String
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id])

  propertyTypeId String
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id])

  propertyCategoryId String?
  propertyCategory   PropertyCategory? @relation(fields: [propertyCategoryId], references: [id])

  propertyTenureId String?
  propertyTenure   PropertyTenure? @relation(fields: [propertyTenureId], references: [id])

  propertyStatusId String?
  propertyStatus   PropertyStatus? @relation(fields: [propertyStatusId], references: [id])

  // Buildings
  buildings Building[]

  ownerships Ownership[]

  isActive Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([organizationUnitId])
  @@index([propertyTypeId])
  @@index([propertyCategoryId])
  @@index([propertyTenureId])
  @@index([propertyStatusId])
  @@index([isActive])
}

model Region {
  id String @id @default(cuid())

  code String
  name String

  countryId String

  country Country @relation(fields: [countryId], references: [id])

  zones    Zone[]
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@index([countryId])
}

model Zone {
  id String @id @default(cuid())

  code String
  name String

  regionId String

  region Region @relation(fields: [regionId], references: [id])

  woredas  Woreda[]
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regionId, code])
  @@unique([regionId, name])
  @@index([regionId])
}

model Woreda {
  id String @id @default(cuid())

  zoneId String

  zone Zone @relation(fields: [zoneId], references: [id])

  code String
  name String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, code])
  @@unique([zoneId, name])
  @@index([zoneId])
}

model PropertyCategory {
  id String @id @default(cuid())

  code        String  @unique
  name        String  @unique
  description String?

  parentId String?
  parent   PropertyCategory?  @relation("PropertyCategoryHierarchy", fields: [parentId], references: [id])
  children PropertyCategory[] @relation("PropertyCategoryHierarchy")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@index([parentId])
  @@index([isActive])
}

model BuildingType {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings Building[]

  @@index([isActive])
}

model BuildingCondition {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings Building[]

  @@index([isActive])
}

model Building {
  id String @id @default(cuid())

  // Identity
  buildingCode String
  name         String
  description  String?

  // Relationships
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  buildingTypeId String
  buildingType   BuildingType @relation(fields: [buildingTypeId], references: [id])

  buildingConditionId String?
  buildingCondition   BuildingCondition? @relation(fields: [buildingConditionId], references: [id])

  spaces BuildingSpace[]

  // Physical characteristics
  numberOfFloors    Int?
  numberOfBasements Int?

  // Construction
  yearBuilt     Int?
  yearRenovated Int?

  // Areas
  floorAreaSqm  Decimal?
  usableAreaSqm Decimal?

  // Capacity
  numberOfRooms   Int?
  numberOfUnits   Int?
  parkingCapacity Int?

  // Lifecycle
  isActive Boolean @default(true)

  // Additional information
  accessibilityFeatures String?
  notes                 String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, buildingCode])
  @@index([propertyId])
  @@index([buildingTypeId])
  @@index([buildingConditionId])
  @@index([isActive])
}

model BuildingSpace {
  id String @id @default(cuid())

  // Identity
  code String
  name String

  // Relationships
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  spaceTypeId String
  spaceType   BuildingSpaceType @relation(fields: [spaceTypeId], references: [id])

  // Physical characteristics
  floorNumber Int?
  areaSqm     Decimal?
  capacity    Int?

  // Lifecycle
  isActive Boolean @default(true)

  // Additional information
  notes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, code])
  @@index([buildingId])
  @@index([spaceTypeId])
  @@index([isActive])
}

model BuildingSpaceType {
  id String @id @default(cuid())

  // Business fields
  code        String
  name        String
  description String?

  // Lifecycle
  isActive Boolean @default(true)

  // Relationships
  spaces BuildingSpace[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@unique([code])
  @@unique([name])
  @@index([isActive])
}

model OwnershipType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerships Ownership[]
}

model Ownership {
  id String @id @default(cuid())

  propertyId      String
  ownershipTypeId String

  startDate DateTime
  endDate   DateTime?

  acquisitionDate     DateTime?
  acquisitionPrice    Decimal?  @db.Decimal(18, 2)
  acquisitionCurrency String?

  deedNumber            String?
  legalReference        String?
  registrationAuthority String?

  notes String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property      Property      @relation(fields: [propertyId], references: [id])
  ownershipType OwnershipType @relation(fields: [ownershipTypeId], references: [id])

  @@index([propertyId])
  @@index([ownershipTypeId])
  @@index([propertyId, isActive])
}
